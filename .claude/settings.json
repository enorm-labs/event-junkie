{
  "extraKnownMarketplaces": {
    "fluxcd": {
      "source": {
        "source": "github",
        "repo": "fluxcd/agent-skills"
      }
    }
  },
  "enabledPlugins": {
    "gitops-skills@fluxcd": true,
    "kotlin-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$CLAUDE_PROJECT_DIR/scripts/jdk-env.sh\" ] || \"$CLAUDE_PROJECT_DIR/scripts/jdk-env.sh\" --claude-hook"
          }
        ]
      }
    ]
  }
}
