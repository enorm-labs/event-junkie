  {
    "id": 2582,
    "date": "2026-03-03T18:20:51",
    "date_gmt": "2026-03-03T17:20:51",
    "guid": {
      "rendered": "https://www.interkosmos.cc/?post_type=ik_event&#038;p=2582"
