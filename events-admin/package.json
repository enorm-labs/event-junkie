{
  "name": "events-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "//dev": "Local only, never built into an image (ADR-045). The mode names the cluster: `npm run dev -- --mode staging` proxies /api/admin to the forward `scripts/ej.sh up staging` opened.",
    "dev": "vite --configLoader native",
    "build": "run-p type-check build-only",
    "build-only": "vite build --configLoader native",
    "test:unit": "vitest --configLoader native",
    "type-check": "vue-tsc --build",
    "check:lint": "oxlint && eslint",
    "check:format": "oxfmt --check src",
    "check:knip": "knip --no-progress",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint --fix",
    "lint:eslint": "eslint --fix --cache",
    "format": "oxfmt src",
    "shadcn": "npx --yes shadcn-vue@2.8.2"
  },
  "dependencies": {
    "@lucide/vue": "1.72.0",
    "@tanstack/vue-table": "9.3.1",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "vue": "3.5.45",
    "vue-router": "5.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tsconfig/node26": "26.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.93.0",
    "eslint-plugin-vue": "10.12.1",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "jiti": "2.7.0",
    "jsdom": "31.0.0",
    "knip": "6.45.1",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "//overrides": "The same glob and minimatch overrides as events-frontend/package.json, for the same build tooling; that file's note says when to drop them.",
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
