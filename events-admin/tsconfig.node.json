{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["vite.config.*", "vitest.config.*", "eslint.config.*", "src/lib/environments.ts"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    // The configs import with an explicit `.ts` for `--configLoader native`, as in events-frontend.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
