### --- Create Zur Klappe event source ---
# Links the venue to the ZurKlappeWebsiteImporter.
# The sourceType "ZUR_KLAPPE" matches EventSource.ZUR_KLAPPE.
POST {{importer-host}}/api/admin/event-sources
Content-Type: application/json

{
    "venueId": {{zur_klappe_venue_id}},
    "name": "Zur Klappe",
    "url": "https://zurklappe.org/events",
    "sourceType": "ZUR_KLAPPE",
    "enabled": true,
    "importIntervalMinutes": 1440,
    "maxRetries": 3
}

> {%
    client.test("Zur Klappe event source created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
%}

