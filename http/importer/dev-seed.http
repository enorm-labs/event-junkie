POST {{importer-host}}/api/admin/event-sources
Content-Type: application/json

{
    "venueId": {{eschschloraque_venue_id}},
    "name": "Eschschloraque",
    "url": "https://www.eschschloraque.de/",
    "sourceType": "ESCHSCHLORAQUE",
    "enabled": true,
    "importIntervalMinutes": 1440,
    "maxRetries": 3
}

> {%
    client.test("Eschschloraque event source created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
%}

### --- Trigger initial Eschschloraque import ---
POST {{importer-host}}/api/admin/event-sources/eschschloraque/import
Accept: application/json

> {%
    client.test("Eschschloraque import triggered", function () {
        client.assert(response.status === 202, "Expected 202 but got " + response.status);
    });
%}

