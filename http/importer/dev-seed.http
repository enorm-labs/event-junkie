### 808 Nachtklub Berlin (Budapester Straße 38-40, Berlin-Charlottenburg)
### ————————————————————————————————————————————————————————————

### --- Create 808 Nachtklub Berlin venue ---
POST {{importer-host}}/api/admin/venues
Content-Type: application/json

{
    "name": "808 Nachtklub Berlin",
    "address": "Budapester Straße 38-40",
    "city": "Berlin",
    "postalCode": "10787",
    "district": "charlottenburg",
    "latitude": 52.505420,
    "longitude": 13.338855,
    "websiteUrl": "https://808.berlin/",
    "description": "A nightclub in the Bikini Berlin complex by the Zoo, open on Friday and Saturday nights, with the Heartbreak party every Friday and bookable booths.",
    "descriptionLanguage": "en",
    "descriptionAlt": "Nachtclub im Bikini Berlin am Zoo, freitags und samstags geöffnet, mit der Reihe Heartbreak an jedem Freitag und buchbaren Lounges.",
    "descriptionAltLanguage": "de",
    "venueTypes": ["club"],
    "reviewedAt": "2026-10-06T20:48:21Z"
}

> {%
    client.global.set("nachtklub_808_venue_id", response.body.id);
    client.test("808 Nachtklub Berlin venue created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
%}

### --- Create 808 Nachtklub Berlin event source ---
# Links the venue to the Nachtklub808WebsiteImporter.
# The sourceType "NACHTKLUB_808" matches EventSource.NACHTKLUB_808.
POST {{importer-host}}/api/admin/event-sources
Content-Type: application/json

{
    "venueId": {{nachtklub_808_venue_id}},
    "name": "808 Nachtklub Berlin",
    "url": "https://808.berlin/",
    "sourceType": "NACHTKLUB_808",
    "enabled": true,
    "importIntervalMinutes": 1440,
    "maxRetries": 3
}

> {%
    client.test("808 Nachtklub Berlin event source created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
%}

### --- Trigger initial 808 Nachtklub Berlin import ---
POST {{importer-host}}/api/admin/event-sources/808-nachtklub-berlin/import
Accept: application/json

> {%
    client.test("808 Nachtklub Berlin import triggered", function () {
        client.assert(response.status === 202, "Expected 202 but got " + response.status);
    });
%}

