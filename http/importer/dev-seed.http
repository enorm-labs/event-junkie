### ————————————————————————————————————————————————————————————
### Admiralspalast (Friedrichstr. 101, Berlin-Mitte)
### ————————————————————————————————————————————————————————————

### --- Create Admiralspalast venue ---
POST {{importer-host}}/api/admin/venues
Content-Type: application/json

{
    "name": "Admiralspalast",
    "address": "Friedrichstr. 101",
    "city": "Berlin",
    "postalCode": "10117",
    "district": "mitte",
    "latitude": 52.52077,
    "longitude": 13.38890,
    "websiteUrl": "https://www.admiralspalast.theater",
    "description": "The Friedrichstrasse variety theatre — musicals, comedy, concerts and dance in a 1910 revue house."
}

> {%
    client.global.set("admiralspalast_venue_id", response.body.id);
    client.test("Admiralspalast venue created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
%}

### --- Create Admiralspalast event source ---
# Links the venue to the AdmiralspalastWebsiteImporter.
# The sourceType "ADMIRALSPALAST" matches EventSource.ADMIRALSPALAST.
POST {{importer-host}}/api/admin/event-sources
Content-Type: application/json

{
    "venueId": {{admiralspalast_venue_id}},
    "name": "Admiralspalast",
    "url": "https://www.admiralspalast.theater/veranstaltungsuebersicht.html",
    "sourceType": "ADMIRALSPALAST",
    "enabled": true,
    "importIntervalMinutes": 1440,
    "maxRetries": 3
}

> {%
    client.test("Admiralspalast event source created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
%}

### --- Trigger initial Admiralspalast import ---
POST {{importer-host}}/api/admin/event-sources/admiralspalast/import
Accept: application/json

> {%
    client.test("Admiralspalast import triggered", function () {
        client.assert(response.status === 202, "Expected 202 but got " + response.status);
    });
%}

