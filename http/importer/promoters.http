### ============================================================
### Admin: Promoters — CRUD lifecycle
### ============================================================

### List all promoters
GET {{importer-host}}/api/admin/promoters
Accept: application/json

> {%
    client.test("status is 200", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
    // The assertion this listing had no way to make before #810: a bare array cannot say it was
    // cut short, so a first page and a complete list were the same response.
    client.test("reports how much there is", function () {
        client.assert(Array.isArray(response.body.content), "Expected a content array");
        client.assert(typeof response.body.totalElements === "number", "Expected totalElements");
        client.assert(
            response.body.content.length <= response.body.totalElements,
            "A page cannot hold more than the total: " +
                response.body.content.length + " > " + response.body.totalElements
        );
    });
%}

### List promoters — page 0, 10 per page, sorted by name ascending
GET {{importer-host}}/api/admin/promoters?page=0&size=10&sort=name,asc
Accept: application/json

> {%
    client.test("status is 200", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### Get promoter by ID
GET {{importer-host}}/api/admin/promoters/1
Accept: application/json

### Create promoter — 36 Concerts
POST {{importer-host}}/api/admin/promoters
Content-Type: application/json

{
    "name": "36 Concerts",
    "websiteUrl": "https://www.facebook.com/36Concerts/"
}

> {%
    client.global.set("promoter_id", response.body.id);
    client.test("status is 201", function () {
        client.assert(response.status === 201, "Expected 201 Created");
    });
%}

### Create promoter — Puschen Concerts
POST {{importer-host}}/api/admin/promoters
Content-Type: application/json

{
    "name": "Puschen Concerts",
    "websiteUrl": "https://puschen.net/",
    "imageUrl": "https://example.com/puschen-logo.jpg"
}

> {%
    client.global.set("second_promoter_id", response.body.id);
    client.test("status is 201", function () {
        client.assert(response.status === 201, "Expected 201 Created");
    });
%}

### Update promoter
PUT {{importer-host}}/api/admin/promoters/{{promoter_id}}
Content-Type: application/json

{
    "name": "36 Concerts",
    "websiteUrl": "https://www.facebook.com/36Concerts/",
    "imageUrl": "https://example.com/36-concerts-logo.jpg"
}

> {%
    client.test("status is 200", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### Delete promoter
DELETE {{importer-host}}/api/admin/promoters/{{promoter_id}}

> {%
    client.test("status is 204", function () {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
    });
%}

### Delete Puschen Concerts — leaves the database as this file found it
DELETE {{importer-host}}/api/admin/promoters/{{second_promoter_id}}

> {%
    client.test("status is 204", function () {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
    });
%}

### Get non-existent promoter (expect 404)
GET {{importer-host}}/api/admin/promoters/999999
Accept: application/json

> {%
    client.test("status is 404", function () {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}

