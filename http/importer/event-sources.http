### List all event sources
GET {{importer-host}}/api/admin/event-sources
Accept: application/json

> {%
    client.test("status is 200", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
    // The assertion this listing had no way to make before #810: a bare array cannot say it was
    // cut short, so a first page and a complete list were the same response.
    client.test("reports how much there is", function () {
        client.assert(Array.isArray(response.body.content), "Expected a content array");
        client.assert(typeof response.body.totalElements === "number", "Expected totalElements");
        client.assert(
            response.body.content.length <= response.body.totalElements,
            "A page cannot hold more than the total: " +
                response.body.content.length + " > " + response.body.totalElements
        );
    });
%}

### Create the venue this file's sources hang off
###
### Its own, rather than a hardcoded `venueId: 1`. Nothing guarantees an id 1 exists, and a source
### create against a missing venue answers 404 — which reads as a broken endpoint rather than a
### missing fixture. Deleted at the end, so the file leaves the database as it found it.
POST {{importer-host}}/api/admin/venues
Content-Type: application/json

{
    "name": "Event Source Fixture Venue",
    "address": "Skalitzer Str. 1",
    "city": "Berlin",
    "postalCode": "10999"
}

> {%
    client.global.set("source_venue_id", response.body.id);
    client.test("status is 201", function () {
        client.assert(response.status === 201, "Expected 201 Created");
    });
%}

### Create a new event source
POST {{importer-host}}/api/admin/event-sources
Content-Type: application/json
Accept: application/json

{
    "venueId": {{source_venue_id}},
    "name": "Privatclub Website",
    "url": "https://privatclub-berlin.de/",
    "sourceType": "PRIVATCLUB",
    "enabled": true,
    "importIntervalMinutes": 1440,
    "maxRetries": 3
}

> {%
    client.test("should return 201", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
    // The slug is server-generated, and every request below addresses the source by it. Nothing
    // set source_slug before, so those requests sent the template placeholder itself and failed
    // with "Illegal character in path".
    client.global.set("source_slug", response.body.slug);
%}

