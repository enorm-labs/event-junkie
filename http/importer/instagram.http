### ============================================================
### Admin: Instagram drafts — ADR-048, issue #3366
###
### Reads the posts of venues switched on in `instagram_venue` through
### Business Discovery and drafts their events. Writes drafts, never an
### event. Both routes answer 409 while app.instagram.enabled is false.
### ============================================================

### Start a background read of one venue; the importer log carries the result
POST {{importer-host}}/api/admin/instagram/venues/rso-berlin/read
Accept: application/json

> {%
    client.test("202, or 404 for a venue not switched on, or 409 while off or a run is going", function () {
        client.assert([202, 404, 409].includes(response.status), "Expected 202, 404 or 409 but got " + response.status);
    });
%}

### Start the daily pass now, over every venue switched on
POST {{importer-host}}/api/admin/instagram/run
Accept: application/json

> {%
    client.test("202, or 409 while off or a run is going", function () {
        client.assert(response.status === 202 || response.status === 409, "Expected 202 or 409 but got " + response.status);
    });
%}

### The pending drafts, the soonest night first
GET {{importer-host}}/api/admin/instagram-drafts?status=PENDING&size=50
Accept: application/json

> {%
    client.test("200 with a page", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(typeof response.body.totalElements === "number", "No totalElements: " + JSON.stringify(response.body));
    });
%}

### Reject the night of a draft: every pending draft of its venue and date
POST {{importer-host}}/api/admin/instagram-drafts/1/reject
Accept: application/json

> {%
    client.test("200, or 404 for an unknown draft, or 409 for one judged already", function () {
        client.assert([200, 404, 409].includes(response.status), "Expected 200, 404 or 409 but got " + response.status);
    });
%}

### The venues whose account the pass reads
GET {{importer-host}}/api/admin/instagram/venues
Accept: application/json

> {%
    client.test("200 with a list", function () {
        client.assert(response.status === 200 && Array.isArray(response.body), "Expected a list but got " + response.status);
    });
%}
