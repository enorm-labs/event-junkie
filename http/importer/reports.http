### ============================================================
### Admin: Reports — "Report a problem" from event pages (#4399)
###
### The queue /fix-events works through, resolving an event's
### reports (which deletes them), and the allowlist of accounts
### that see the button.
### ============================================================

### The open reports, one entry per event
GET {{importer-host}}/api/admin/reports
Accept: application/json

> {%
    client.test("status is 200", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### Resolve every report on one event (deletes them)
DELETE {{importer-host}}/api/admin/reports?eventId=1
Accept: application/json

> {%
    client.test("status is 200", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### Allow an account to report problems
PUT {{importer-host}}/api/admin/accounts/can-report
Content-Type: application/json

{ "email": "operator@example.de", "enabled": true }

> {%
    client.test("status is 204", function () {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
    });
%}
