### ============================================================
### Admin: Venues — CRUD lifecycle
### ============================================================

### List all venues
GET {{importer-host}}/api/admin/venues
Accept: application/json

> {%
    client.test("status is 200", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
    // The assertion this listing had no way to make before #810: a bare array cannot say it was
    // cut short, so a first page and a complete list were the same response.
    client.test("reports how much there is", function () {
        client.assert(Array.isArray(response.body.content), "Expected a content array");
        client.assert(typeof response.body.totalElements === "number", "Expected totalElements");
        client.assert(
            response.body.content.length <= response.body.totalElements,
            "A page cannot hold more than the total: " +
                response.body.content.length + " > " + response.body.totalElements
        );
    });
%}

### List venues — page 0, 10 per page, sorted by name ascending
GET {{importer-host}}/api/admin/venues?page=0&size=10&sort=name,asc
Accept: application/json

> {%
    client.test("status is 200", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### Deliberately unasserted: which row holds id 1 depends on what the database already contains,
### so any fixed expectation here is wrong somewhere. The list endpoints above carry the assertions.
### Get venue by ID
GET {{importer-host}}/api/admin/venues/1
Accept: application/json

### Create venue — Astra Kulturhaus
POST {{importer-host}}/api/admin/venues
Content-Type: application/json

{
    "name": "Astra Kulturhaus",
    "address": "Revaler Str. 99",
    "city": "Berlin",
    "postalCode": "10245",
    "latitude": 52.507242,
    "longitude": 13.451803,
    "websiteUrl": "https://www.astra-berlin.de"
}

> {%
    client.global.set("venue_id", response.body.id);
    client.test("status is 201", function () {
        client.assert(response.status === 201, "Expected 201 Created");
    });
%}

### Create venue — SO36
POST {{importer-host}}/api/admin/venues
Content-Type: application/json

{
    "name": "SO36",
    "address": "Oranienstraße 190",
    "city": "Berlin",
    "postalCode": "10999",
    "websiteUrl": "https://so36.com"
}

> {%
    client.global.set("second_venue_id", response.body.id);
    client.test("status is 201", function () {
        client.assert(response.status === 201, "Expected 201 Created");
    });
%}

### Update venue
PUT {{importer-host}}/api/admin/venues/{{venue_id}}
Content-Type: application/json

{
    "name": "Astra Kulturhaus",
    "address": "Revaler Str. 99",
    "city": "Berlin",
    "postalCode": "10245",
    "latitude": 52.507242,
    "longitude": 13.451803,
    "websiteUrl": "https://www.astra-berlin.de",
    "imageUrl": "https://example.com/astra-logo.jpg"
}

> {%
    client.test("status is 200", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### Delete venue
DELETE {{importer-host}}/api/admin/venues/{{venue_id}}

> {%
    client.test("status is 204", function () {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
    });
%}

### Delete SO36 — leaves the database as this file found it
DELETE {{importer-host}}/api/admin/venues/{{second_venue_id}}

> {%
    client.test("status is 204", function () {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
    });
%}

### Get non-existent venue (expect 404)
GET {{importer-host}}/api/admin/venues/999999
Accept: application/json

> {%
    client.test("status is 404", function () {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}

