# Without this file nothing is excluded from `helm package`, so a stray editor or OS artefact would
# ship inside the published chart (#264). Everything else in this directory is chart content.
.DS_Store
.git/
.gitignore
*.swp
*.bak
*.tmp
*.orig
*~
.idea/
.vscode/

# The helm-unittest suites (#430). Anchored with a leading slash, and that is load-bearing: a bare
# `tests/` matches at any depth, so it would also exclude `templates/tests/connection-test.yaml` —
# the `helm test` hook — from the published chart. Two different things called tests, one directory
# name apart.
/tests/
