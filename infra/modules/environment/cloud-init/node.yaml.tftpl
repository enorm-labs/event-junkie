#cloud-config
# Rendered by infra/modules/environment/cloudinit.tf. Do not edit on the node.
hostname: ${hostname}
fqdn: ${hostname}
preserve_hostname: false

package_update: true
package_upgrade: true

# Hetzner injects the project's SSH keys into root; harden.sh then disables root login, so this
# account is the only way back in over SSH. No password is ever set - `lock_passwd` makes that
# explicit rather than incidental.
users:
  - name: ops
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
%{~ for key in ssh_public_keys }
      - "${key}"
%{~ endfor }

# The scripts travel gzipped and base64-encoded, the small config files as they are. Hetzner caps
# user_data at 32 KiB and the plain scripts alone passed it (#1482); cloud-init decodes `gz+b64`
# itself, so the node still gets the script byte for byte, comments included. infra/check_user_data.py
# renders this with sample values and fails when either role nears the cap.
write_files:
%{~ for file in files }
  - path: ${file.path}
    owner: root:root
    permissions: "${file.permissions}"
%{~ if endswith(file.path, ".sh") }
    encoding: gz+b64
    content: ${base64gzip(file.content)}
%{~ else }
    content: |
      ${indent(6, file.content)}
%{~ endif }
%{~ endfor }

runcmd:
%{~ for command in runcmd }
  - ${command}
%{~ endfor }

final_message: "cloud-init finished after $UPTIME seconds"
