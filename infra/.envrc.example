# Credentials for the OpenTofu stacks, loaded by direnv:
#
#   cp .envrc.example .envrc && direnv allow
#
# `.envrc` rather than `.env` because direnv unloads it on leaving `infra/`; a sourced `.env`
# leaves a token with full read/write over the Hetzner project in every unrelated command after.
#
# Nothing secret belongs in this file: the values come out of the macOS Keychain. Store the three
# secrets once (`-w` with no value prompts, so nothing reaches shell history):
#
#   security add-generic-password -a "$USER" -s event-junkie-hcloud-token  -w
#   security add-generic-password -a "$USER" -s event-junkie-s3-access-key -w
#   security add-generic-password -a "$USER" -s event-junkie-s3-secret-key -w
#
# direnv evaluates this with bash regardless of your login shell; keep it bash-compatible.

keychain() { security find-generic-password -a "$USER" -s "$1" -w 2>/dev/null || true; }

# Hetzner Cloud API token: servers, networks, firewalls, Primary IPs and DNS.
export HCLOUD_TOKEN="$(keychain event-junkie-hcloud-token)"

# Object Storage (S3) credentials, for the state backend and the `aws` CLI setup in README.md.
# Project-scoped, not bucket-scoped: one pair reaches every bucket.
export AWS_ACCESS_KEY_ID="$(keychain event-junkie-s3-access-key)"
export AWS_SECRET_ACCESS_KEY="$(keychain event-junkie-s3-secret-key)"

# Hetzner's S3 is not AWS: the "region" is the location and the endpoint has to be stated. These
# let `aws s3api …` work without `--endpoint-url`. Change both together if you move location.
export AWS_DEFAULT_REGION=fsn1
export AWS_ENDPOINT_URL_S3=https://fsn1.your-objectstorage.com

# The MinIO provider manages the `-o2` bucket (#271) and reads MINIO_*, so these are the SAME
# credential under its names, nothing new in the Keychain. The endpoint has NO scheme here, unlike
# AWS_ENDPOINT_URL_S3: the provider takes `host[:port]`, and the URL form fails at connect time.
export MINIO_ENDPOINT=fsn1.your-objectstorage.com
export MINIO_USER="$AWS_ACCESS_KEY_ID"
export MINIO_PASSWORD="$AWS_SECRET_ACCESS_KEY"

# Behind a TLS-intercepting proxy the AWS CLI fails every call with
# `CERTIFICATE_VERIFY_FAILED … self-signed certificate in certificate chain`: it ships its own CA
# bundle and never consults the macOS keychain, while `curl` and OpenTofu trust the system store.
# Build the bundle once (README, "Behind a TLS-intercepting proxy"); inert on any other machine.
if [ -f "$HOME/.certs/aws-ca-bundle.pem" ]; then
    export AWS_CA_BUNDLE="$HOME/.certs/aws-ca-bundle.pem"
fi

# An empty variable produces an authentication error three commands later that looks like a
# broken backend config. The MINIO_* names were added after their absence cost an apply (#271):
# `.envrc` is personal and gitignored, so the provider signed anonymously and Hetzner answered
# `AccessDenied`, which reads as a wrong key. If you add a variable above, add it here too.
for _var in HCLOUD_TOKEN AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY MINIO_ENDPOINT MINIO_USER MINIO_PASSWORD; do
    if [ -z "${!_var}" ]; then
        echo "envrc: ${_var} is empty — is it in the Keychain under the name above?" >&2
    fi
done
unset _var

# ---------------------------------------------------------------------------
# Plaintext alternative, only ever in `.envrc`, never here: a file holding cloud-admin credentials
# inside a public repository's working tree, with `.gitignore` and gitleaks as the second and
# third lines of defence.
#
# export HCLOUD_TOKEN=...
# export AWS_ACCESS_KEY_ID=...
# export AWS_SECRET_ACCESS_KEY=...
