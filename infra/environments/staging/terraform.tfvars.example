# Copy to terraform.tfvars and fill in; real .tfvars files are gitignored. Credentials come from
# direnv (infra/.envrc.example).

# From: tofu -chdir=../../bootstrap output -json ssh_key_ids
ssh_key_ids = ["12345678"]

# OpenSSH authorized_keys lines for the unprivileged `ops` user, the only login once cloud-init
# disables root.
ssh_public_keys = [
  "ssh-ed25519 AAAA... you@laptop",
]

# WireGuard clients, public keys only: base64, exactly 44 characters, ending in `=`. An SSH key
# is rejected at plan time, because a wrong one boots a node with no tunnel and no open port.
#
#   umask 077 && mkdir -p ~/.wireguard
#   wg genkey > ~/.wireguard/staging.key    # private: stays on the device, never here
#   wg pubkey < ~/.wireguard/staging.key    # public: paste below
#
# Addresses are 10.10.1.x here, production's peers on 10.10.0.x, and both tunnels are up at once;
# they must sit inside `wireguard_subnet` and be unique, checked at plan time.
wireguard_peers = [
  {
    name       = "macbook"
    public_key = "AAAA...="
    address    = "10.10.1.2"
  },
]

# Empty is the steady state: 22 and 6443 unreachable from the internet, the tunnel the only way in.
# The first apply is the exception, WireGuard not running yet; pass it on the command line:
#
#   ADMIN="[\"$(curl -s https://ifconfig.me)/32\",\"$(dig +short myip.opendns.com @resolver1.opendns.com | tail -1)/32\"]"
#   tofu apply -var "admin_cidrs=$ADMIN"
#
# Two addresses behind a corporate HTTP proxy: `ifconfig.me` reports the proxy's egress, while
# SSH and WireGuard are not proxied, so an allowlist from it alone refuses the connection it was
# meant to admit. The `dig` goes over UDP/53, unproxied.
admin_cidrs = []
