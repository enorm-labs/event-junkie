# Markdown belongs to oxfmt — `scripts/format-markdown.sh`, configured in `.oxfmtrc.json`.
#
# The `ij_markdown_*` keys that used to live here were removed because they lost a fight they could
# only ever draw: `ij_markdown_format_tables` pads table cells to different widths than oxfmt does,
# and `ij_markdown_wrap_text_if_long` reflows prose at 160 that oxfmt is configured to leave exactly
# where the author put it (`proseWrap: preserve`). Two formatters, one file type, opposite opinions —
# every Reformat Code undid the last commit hook and vice versa.
#
# Removing the keys unpins IntelliJ's Markdown settings; it does not disable its formatter. Reformat
# Code on a .md file will still reflow it using IDE defaults. The pre-commit hook runs oxfmt last and
# normalises whatever the IDE did, so commits stay consistent either way — but the tidy habit is to
# leave Markdown to the script rather than to Cmd+Alt+L.

# `tofu fmt` is deliberately non-configurable and indents with two spaces. Without this, the `[*]`
# default of four puts every editor in direct conflict with the CI format check.
[{*.tf,*.tftpl,*.tfvars}]
indent_size = 2

[{*.yaml,*.yml}]
indent_size = 2
ij_yaml_align_values_properties = do_not_align
ij_yaml_autoinsert_sequence_marker = true
ij_yaml_block_mapping_on_new_line = false
ij_yaml_indent_sequence_value = true
ij_yaml_keep_indents_on_empty_lines = false
ij_yaml_keep_line_breaks = true
ij_yaml_line_comment_add_space = false
ij_yaml_line_comment_add_space_on_reformat = false
ij_yaml_line_comment_at_first_column = true
ij_yaml_sequence_on_new_line = false
ij_yaml_space_before_colon = false
ij_yaml_spaces_within_braces = true
ij_yaml_spaces_within_brackets = true
