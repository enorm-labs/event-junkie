// TSConfig for modules that run in Node.js environment via either transpilation or type-stripping.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "eslint.config.*",
    // Build-time helpers imported by the configs above (e.g. the sitemap plugin). They are checked
    // transitively either way; listing them means they stay checked if a config stops importing one.
    "scripts/**/*.ts",
    "eslint-rules/**/*.ts",
    // The meta-injection sidecar. Node code, not app code: it uses `node:http` and has no DOM, so
    // it is checked here rather than under tsconfig.app.json.
    "injector/**/*.ts",
    // `virtual:page-meta-text`, which `src/lib/staticPages.ts` imports on the injector's behalf.
    "src/lib/pageMetaText.d.ts"
  ],
  "compilerOptions": {
    // Most tools use transpilation instead of Node.js's native type-stripping.
    // Bundler mode provides a smoother developer experience.
    "module": "preserve",
    "moduleResolution": "bundler",
    // `vite.config.ts` and the helpers it pulls in import each other with an explicit `.ts`, because
    // Vite's `configLoader: 'native'` resolves them through Node's ESM resolver. Safe here because
    // this project emits nothing (`noEmit` below). `tsconfig.app.json` gets the same setting from
    // `@vue/tsconfig`, which is why only this one needs it spelled out.
    "allowImportingTsExtensions": true,
    // Include Node.js types and avoid accidentally including other `@types/*` packages.
    "types": ["node"],
    // The injector imports `src/lib/pageMeta.ts`, which imports through `@/`.
    "paths": {
      "@/*": ["./src/*"]
    },
    // Disable emitting output during `vue-tsc --build`, which is used for type-checking only.
    "noEmit": true,
    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
