{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  // The injector is a second Vite build (vite.injector.config.ts). The CSS script runs by hand and
  // from dashboard-parity.sh.
  "entry": ["injector/server.ts", "scripts/ops-page-css.mjs"],
  // ops-page-css.mjs uses the two packages @tailwindcss/vite ships beside it at the same version, so
  // listing them would be a second pin to keep in step.
  "ignoreDependencies": ["@tailwindcss/node", "@tailwindcss/oxide"],
  // A constant exported for its doc comment or a test does no harm while the file still uses it.
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    // Generated by openapi-typescript; its exports are the whole API, used or not.
    "src/api/schema.d.ts": ["types"],
  },
}
